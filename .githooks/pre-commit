#!/bin/sh
# Antes de cada commit (repo PÚBLICO): el escáner revisa exactamente lo que va en el
# commit —el índice, no la carpeta de trabajo— y lo detiene si encuentra datos
# personales o secretos. Se activa una vez por clon:  git config core.hooksPath .githooks
set -e
temporal="$(mktemp -d)"
trap 'rm -rf "$temporal"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git checkout-index --prefix="$temporal/" --
if [ -z "$(ls -A "$temporal")" ]; then exit 0; fi
python3 scripts/verificar_publicacion.py "$temporal" >/dev/null || {
  python3 scripts/verificar_publicacion.py "$temporal" | sed "s|$temporal/||" >&2
  echo "Commit detenido: revisa los hallazgos de arriba (scripts/verificar_publicacion.py)." >&2
  exit 1
}
